# Copy to .env.local and fill from the Firebase console:
# Project settings → General → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloudflare R2 — server-only. No NEXT_PUBLIC_ prefix: these must never reach
# the browser. Create them in Cloudflare → R2 → Manage API tokens
# (Object Read & Write, scoped to this one bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=r2-glowze-secure

# Google AI Studio / Gemini — server-only, no NEXT_PUBLIC_ prefix.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check what your key can serve:  node --env-file=.env.local scripts/check-gemini.mjs
GEMINI_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Firebase Admin — server-only. The Polar webhook and /api/checkout/confirm
# write the subscription with the Admin SDK, which is the only way to set a
# field the browser is not allowed to set itself. Paste the whole service
# account JSON on one line (Firebase console → Project settings → Service
# accounts → Generate new private key). Without it the payment still unlocks
# the session, but nothing is stored and the unlock is lost on the next
# device.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Polar payment gateway — all server-only, no NEXT_PUBLIC_ prefix. Product IDs
# are read in route handlers and in lib/polar.ts (server-only), never in the
# browser.
#
# POLAR_SERVER selects which Polar the app talks to. Anything other than
# "production" means sandbox, so a forgotten variable fails safe.
#
# The webhook URL registered in Polar must be exactly
#   https://<your-domain>/api/webhook/polar
# One extra slash and Next.js answers 308; webhook POSTs do not follow
# redirects, so every delivery fails without ever reaching the handler.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_TRIAL=
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_YEARLY=
POLAR_PRODUCT_YEARLY_EXIT=
